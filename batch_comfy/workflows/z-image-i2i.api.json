{
  "20": {
    "class_type": "LoadImage",
    "_meta": { "title": "素材图" },
    "inputs": { "image": "example.png", "upload": "image" }
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "UNet加载" },
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "fp8_e4m3fn_fast" }
  },
  "4": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "CLIP加载" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default" }
  },
  "7": {
    "class_type": "VAELoader",
    "_meta": { "title": "VAE加载" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "采样偏移" },
    "inputs": { "model": ["1", 0], "shift": 3.0 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "正向提示词" },
    "inputs": { "clip": ["4", 0], "text": "转为日系动画赛璐璐风格，保留原始构图与人物姿态" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "反向提示词" },
    "inputs": {
      "clip": ["4", 0],
      "text": "模糊，低分辨率，低质量，扭曲的肢体，水印，乱码，JPEG压缩条纹"
    }
  },
  "21": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE编码素材" },
    "inputs": { "pixels": ["20", 0], "vae": ["7", 0] }
  },
  "2": {
    "class_type": "KSampler",
    "_meta": { "title": "采样器" },
    "inputs": {
      "model": ["3", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["21", 0],
      "seed": 0,
      "steps": 16,
      "cfg": 2.5,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 0.6
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE解码" },
    "inputs": { "samples": ["2", 0], "vae": ["7", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "保存图像" },
    "inputs": { "images": ["8", 0], "filename_prefix": "batch" }
  }
}
