{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "UNet加载" },
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "fp8_e4m3fn_fast" }
  },
  "4": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "CLIP加载" },
